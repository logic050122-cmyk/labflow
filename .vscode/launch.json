{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "调试 LabFlow 后端（当前源码）",
      // 与 package.json 的 dev 命令保持一致，避免误运行旧的 dist/server.js。
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/server/.env",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "presentation": {
        "group": "LabFlow",
        "order": 2
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "调试 LabFlow 前端(5173)",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/web",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "autoAttachChildProcesses": true,
      "presentation": {
        "group": "LabFlow",
        "order": 3
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "调试 LabFlow 前端(5174)",
      // 等价于：npm.cmd run dev -- --port 5174
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5174"
      ],
      "cwd": "${workspaceFolder}/web",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "autoAttachChildProcesses": true,
      "presentation": {
        "group": "LabFlow",
        "order": 4
      }
    }
  ],
  "compounds": [
    {
      "name": "⭐ 一键启动 LabFlow 前后端",
      "configurations": [
        "调试 LabFlow 后端（当前源码）",
        "调试 LabFlow 前端(5173)",
        "调试 LabFlow 前端(5174)"
      ],
      // 停止组合调试时一起关闭三个进程。
      "stopAll": true,
      "presentation": {
        "group": "LabFlow",
        "order": 1
      }
    }
  ]
}